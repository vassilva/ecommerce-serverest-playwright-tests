{
  "name": "automacao-serverest-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "QA automation laboratory for ServeRest using Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --grep @api",
    "test:ui": "playwright test --grep @ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:negative": "playwright test --grep @negative",
    "test:sanity": "playwright test --grep @sanity",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui-mode": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "quality": "npm run lint && npm run format:check && npm run typecheck",
    "report": "playwright show-report"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
